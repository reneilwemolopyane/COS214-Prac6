# Doxygen configuration for the TIVIDY workflow engine.

PROJECT_NAME           = "TIVIDY Workflow Engine"
PROJECT_BRIEF          = "A modular C++ workflow engine and its sample scenarios."
OUTPUT_DIRECTORY       = docs

INPUT                  = adapter \
                         builder \
                         chain_of_responsibility \
                         command \
                         composite_prototype \
                         core \
                         decorator \
                         facade \
                         interpreter \
                         mediator \
                         memento \
                         observer \
                         scenarios \
                         state \
                         strategy \
                         tui \
                         visitor \
                         docs/mainpage.dox
FILE_PATTERNS           = *.h *.hpp *.cpp *.cc *.cxx *.dox
RECURSIVE               = YES
EXCLUDE_PATTERNS        = */third_party/*

EXTRACT_ALL             = YES
EXTRACT_PRIVATE         = NO
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = NO

GENERATE_HTML           = YES
HTML_OUTPUT             = api
GENERATE_TREEVIEW       = YES
GENERATE_LATEX          = NO

QUIET                   = NO
