sequenceDiagram
  participant M as InstanceCoordinator
  participant R as ApprovalRouter
  participant H1 as LevelApprover (Claims Handler, 20 000)
  participant H2 as LevelApprover (Claims Manager, 100 000)
  participant H3 as LevelApprover (Senior Manager, *)
  participant A as WorkAssigner
  participant I as WorkItem
  M->>R: route(amount=45 000, from=-1)
  R->>H1: handleRequest
  H1->>H2: over limit: pass on
  H2-->>R: APPROVED at Claims Manager
  R-->>M: level 1
  M->>I: setRole("Claims Manager")
  M->>A: assign(item)
  Note over M,I: nobody responds in time
  M->>R: route(45 000, from=1)
  R->>H2: deadline passed
  H2->>H3: escalate, fresh deadline
  H3-->>R: APPROVED at Senior Manager
  R-->>M: level 2
  M->>I: escalateTo(participant) (Assigned -> Escalated -> Assigned)
  M-->>M: ROUTED event "escalated Claims Manager -> Senior Manager"
